{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "FeelFed design tokens (DTCG). Single source of truth — edit here only. Fraunces = display/serif, Poppins = UI/labels/sans, Lato = body/mono. Palette: cream #FBF7F2, teal #3A8F88, deep teal #1F4E49, peach #F0A576, water blue #5FA8C4.",
  "color": {
    "$type": "color",
    "light": {
      "background":         { "$value": "#FBF7F2", "$description": "Cream — page background." },
      "foreground":         { "$value": "#1F4E49", "$description": "Deep teal — default text." },
      "border":             { "$value": "#D8CEC4", "$description": "Warm beige border." },
      "card":               { "$value": "#FFFFFF", "$description": "Card surface." },
      "cardForeground":     { "$value": "#1F4E49" },
      "popover":            { "$value": "#FFFFFF" },
      "popoverForeground":  { "$value": "#1F4E49" },
      "primary":            { "$value": "#3A8F88", "$description": "Teal — primary brand color." },
      "primaryForeground":  { "$value": "#FBF7F2", "$description": "Cream on teal." },
      "secondary":          { "$value": "#1F4E49", "$description": "Deep teal — secondary." },
      "secondaryForeground":{ "$value": "#FBF7F2" },
      "muted":              { "$value": "#EDE7DF", "$description": "Warm beige — muted surface." },
      "mutedForeground":    { "$value": "#5C7A77", "$description": "Muted teal-gray text." },
      "accent":             { "$value": "#F0A576", "$description": "Peach — accent highlight." },
      "accentForeground":   { "$value": "#1F4E49", "$description": "Deep teal on peach." },
      "destructive":        { "$value": "#C0392B" },
      "destructiveForeground": { "$value": "#FBF7F2" },
      "input":              { "$value": "#D8CEC4" },
      "ring":               { "$value": "#3A8F88", "$description": "Teal focus ring." },
      "chart1":             { "$value": "#5FA8C4", "$description": "Water blue." },
      "chart2":             { "$value": "#3A8F88", "$description": "Teal." },
      "chart3":             { "$value": "#F0A576", "$description": "Peach." },
      "chart4":             { "$value": "#1F4E49", "$description": "Deep teal." },
      "chart5":             { "$value": "#D4845A", "$description": "Terracotta." },
      "sidebar":            { "$value": "#EDE7DF" },
      "sidebarForeground":  { "$value": "#1F4E49" },
      "sidebarBorder":      { "$value": "#D8CEC4" },
      "sidebarPrimary":     { "$value": "#3A8F88" },
      "sidebarPrimaryForeground": { "$value": "#FBF7F2" },
      "sidebarAccent":      { "$value": "#F0A576" },
      "sidebarAccentForeground": { "$value": "#1F4E49" },
      "sidebarRing":        { "$value": "#3A8F88" },
      "ringFullness":       { "$value": "#26706A", "$description": "Fullness ring — deep teal at full; blends from #BBD8D4 at empty." },
      "ringEnergy":         { "$value": "#FF9E52", "$description": "Energy ring — vivid peach at full; blends from #A3ADAB at empty." },
      "ringHydration":      { "$value": "#3FA9D4", "$description": "Hydration ring — aqua at full; blends from #C4A483 at empty." },
      "water":              { "$value": "#3FB2CE", "$description": "Bowl water — bright aqua when topped up; blends from pale teal #7FB0AA when dry. Never brown/tan." }
    },
    "dark": {
      "background":         { "$value": "#0E2422", "$description": "Very dark teal — dark bg." },
      "foreground":         { "$value": "#FBF7F2", "$description": "Cream — text on dark." },
      "border":             { "$value": "#244F4B" },
      "card":               { "$value": "#152C2A" },
      "cardForeground":     { "$value": "#FBF7F2" },
      "popover":            { "$value": "#152C2A" },
      "popoverForeground":  { "$value": "#FBF7F2" },
      "primary":            { "$value": "#48ADA6", "$description": "Lighter teal for dark mode." },
      "primaryForeground":  { "$value": "#0E2422" },
      "secondary":          { "$value": "#244F4B" },
      "secondaryForeground":{ "$value": "#FBF7F2" },
      "muted":              { "$value": "#1A3633" },
      "mutedForeground":    { "$value": "#8BC0BC" },
      "accent":             { "$value": "#CB7952", "$description": "Muted peach for dark." },
      "accentForeground":   { "$value": "#FBF7F2" },
      "destructive":        { "$value": "#9B2335" },
      "destructiveForeground": { "$value": "#FBF7F2" },
      "input":              { "$value": "#244F4B" },
      "ring":               { "$value": "#48ADA6" },
      "chart1":             { "$value": "#5FA8C4" },
      "chart2":             { "$value": "#48ADA6" },
      "chart3":             { "$value": "#F0A576" },
      "chart4":             { "$value": "#8BC0BC" },
      "chart5":             { "$value": "#D4845A" },
      "sidebar":            { "$value": "#0E2422" },
      "sidebarForeground":  { "$value": "#FBF7F2" },
      "sidebarBorder":      { "$value": "#244F4B" },
      "sidebarPrimary":     { "$value": "#48ADA6" },
      "sidebarPrimaryForeground": { "$value": "#0E2422" },
      "sidebarAccent":      { "$value": "#244F4B" },
      "sidebarAccentForeground": { "$value": "#FBF7F2" },
      "sidebarRing":        { "$value": "#48ADA6" },
      "ringFullness":       { "$value": "#48ADA6" },
      "ringEnergy":         { "$value": "#FF9E52" },
      "ringHydration":      { "$value": "#3FA9D4" },
      "water":              { "$value": "#3FB2CE" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Poppins", "sans-serif"],
        "$description": "UI / labels font — used for ring labels, buttons, and navigation."
      },
      "serif": {
        "$value": ["Fraunces", "serif"],
        "$description": "Display / headline font — used for the hero headline and section titles."
      },
      "mono": {
        "$value": ["Lato", "sans-serif"],
        "$description": "Body / reading font — used for the reflection card and longer prose. (Lato is not monospace; this slot carries FeelFed's body face.)"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Slightly generous radius — soft, organic feel matching FeelFed's gentle tone."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step the shadcn components multiply."
    }
  }
}
